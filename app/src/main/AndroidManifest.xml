<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 播放示例音频/视频需要联网；正式版走 R2 链接同样需要此权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- “仅 WiFi 下载”开关要判断当前是不是 WiFi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 后台播放：前台 Service 保活 + 通知栏控制 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ChengguangApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chengguang">
        <!-- Sentry 8.x 会通过 SentryInitProvider 在 Application.onCreate 之前自动初始化；
             DSN 为空时它会直接崩溃（"DSN is required"），根本到不了 ErrorReporting.init() 的
             空 DSN 保护。先彻底关掉自动初始化，等以后配了真实 DSN 再由 ErrorReporting.init() 手动初始化。 -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Chengguang"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 后台播放的前台 Service：只负责保活和通知栏控制，播放器在 AudioPlayer 单例里 -->
        <service
            android:name=".PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>

</manifest>
